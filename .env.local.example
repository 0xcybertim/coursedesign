# User-created Profile Wing processing is local-only and disabled by default.
PROFILE_WING_CREATION_ENABLED=true
PROFILE_WING_MASK_PROVIDER=remove-bg

# Keep the real credential only in .env.local or the launching shell.
# Never expose it with a NEXT_PUBLIC_ prefix.
REMOVE_BG_API_KEY=replace-with-a-rotated-remove-bg-key

# WorkOS AuthKit. Keep real values only in ignored local environment files or
# the hosting provider's secret store. The onrender.com URL is sufficient.
PERSISTENCE_MODE=server
DATABASE_URL=postgresql://localhost/coursedesign_test
GCS_PROJECT_ID=course-design-local
GCS_BUCKET=course-design-local-private
GCS_LOCATION=europe-west3
GCS_CLIENT_EMAIL=local@example.invalid
GCS_PRIVATE_KEY=not-used-when-local-fake-storage-is-enabled
PERSISTENCE_LOCAL_FAKE_STORAGE=true
AUTH_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
WORKOS_CLIENT_ID=client_replace_me
WORKOS_API_KEY=sk_test_replace_me
WORKOS_WEBHOOK_SECRET=whsec_replace_me
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-bytes
WORKOS_COOKIE_NAME=course-design-auth
WORKOS_COOKIE_MAX_AGE=604800
WORKOS_COOKIE_SAMESITE=lax
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/auth/callback

# Never set WORKOS_COOKIE_DOMAIN. HTTPS uses
# WORKOS_COOKIE_NAME=__Host-course-design-auth.
